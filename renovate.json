{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Ignore Minecraft version and gameplay mod dependencies (handled by Minecraft mod updater)",
      "enabled": false,
      "matchPackageNames": [
        "/^net\\.minecraft/",
        "/^minecraft/",
        "/^dev\\.thomasglasser/",
        "/^software\\.bernie/",
        "/^top\\.theillusivec4/",
        "/^net\\.tslat/",
        "/^com\\.klikli_dev/",
        "/^mezz\\.jei/",
        "/^snownee/",
        "/^com\\.zigythebird/",
        "/^maven\\.modrinth/"
      ]
    },
    {
      "description": "Lock Java JDK version to 21 for Minecraft 1.21.1",
      "enabled": false,
      "matchPackageNames": [
        "java-jdk",
        "java"
      ]
    },
    {
      "description": "Ignore dynamic and toolchain Gradle plugins",
      "enabled": false,
      "matchPackageNames": [
        "dev.lukebemish.immaculate",
        "org.gradle.toolchains.foojay-resolver-convention"
      ]
    },
    {
      "description": "NeoForge Maven registry",
      "registryUrls": [
        "https://maven.neoforged.net/releases"
      ],
      "matchPackageNames": [
        "/^net\\.neoforged/"
      ]
    },
    {
      "description": "Constrain NeoForge updates strictly to 21.1.x for Minecraft 1.21.1",
      "allowedVersions": "/^21\\.1\\./",
      "groupName": "NeoForge",
      "matchPackageNames": [
        "/^net\\.neoforged:neoforge/"
      ]
    },
    {
      "description": "ModDevGradle toolchain updates",
      "groupName": "ModDevGradle",
      "matchPackageNames": [
        "/^net\\.neoforged(\\.moddev|:moddev)/"
      ]
    },
    {
      "description": "Voice Chat API (Minecraft-version independent)",
      "groupName": "Voice Chat API",
      "matchPackageNames": [
        "/^de\\.maxhenkel\\.voicechat:voicechat-api/"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "automerge": false
    }
  ]
}
