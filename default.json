{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Disable Gradle and Gradle Wrapper managers; mod dependencies are tracked via mod_dependencies.json and Gradle version is managed centrally via .github",
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "enabled": false
    },
    {
      "description": "Disallow major Java version upgrades",
      "matchPackageNames": [
        "java-jdk",
        "java",
        "/^actions/setup-java/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "NeoForge Maven registry",
      "registryUrls": [
        "https://maven.neoforged.net/releases"
      ],
      "matchPackageNames": [
        "/^net\\.neoforged/"
      ]
    },
    {
      "description": "Combine all Gradle toolchain plugins and wrapper updates into a single PR",
      "matchPackageNames": [
        "/^net\\.neoforged(\\.moddev|:moddev)/",
        "/^dev\\.lukebemish\\.immaculate/",
        "/^org\\.gradle\\.toolchains\\.foojay-resolver-convention/",
        "gradle"
      ],
      "groupName": "Gradle Toolchain",
      "enabled": true
    }
  ]
}
