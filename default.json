{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "gradle-wrapper": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Disable Gradle manager dependency updates by default; Minecraft mods are tracked via mod_dependencies.json and custom updater",
      "matchManagers": [
        "gradle"
      ],
      "enabled": false
    },
    {
      "description": "Disallow major Java version upgrades",
      "matchPackageNames": [
        "java-jdk",
        "java",
        "/^actions/setup-java/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "NeoForge Maven registry",
      "registryUrls": [
        "https://maven.neoforged.net/releases"
      ],
      "matchPackageNames": [
        "/^net\\.neoforged/"
      ]
    },
    {
      "description": "Combine all Gradle toolchain plugins into a single PR",
      "matchPackageNames": [
        "/^net\\.neoforged(\\.moddev|:moddev)/",
        "/^dev\\.lukebemish\\.immaculate/",
        "/^org\\.gradle\\.toolchains\\.foojay-resolver-convention/",
        "gradle"
      ],
      "groupName": "Gradle Toolchain",
      "enabled": true
    }
  ]
}
